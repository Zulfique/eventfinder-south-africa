# Copy this file to keystore.properties (gitignored) and fill in your own values.
# Generate a keystore with:
#   keytool -genkeypair -v -keystore eventfinder-release.jks -alias eventfinder \
#     -keyalg RSA -keysize 2048 -validity 10000
storeFile=eventfinder-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=eventfinder
keyPassword=YOUR_KEY_PASSWORD
