    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Top-right: brand gold -->
    <path
        android:pathData="M50,13 A37,37 0 0 1 87,50"
        android:strokeColor="#FFB81C"
        android:strokeWidth="15" />
    <!-- Bottom-right: brand green -->
    <path
        android:pathData="M87,50 A37,37 0 0 1 50,87"
        android:strokeColor="#007749"
        android:strokeWidth="15" />
    <!-- Bottom-left: brand blue -->
    <path
        android:pathData="M50,87 A37,37 0 0 1 13,50"
        android:strokeColor="#001489"
        android:strokeWidth="15" />
    <!-- Top-left: brand red -->
    <path
        android:pathData="M13,50 A37,37 0 0 1 50,13"
        android:strokeColor="#E03C31"
        android:strokeWidth="15" />
</vector>
